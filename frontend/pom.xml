<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.sbomscope</groupId>
    <artifactId>sbomscope-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sbomscope-frontend</artifactId>
  <packaging>jar</packaging>

  <name>SBOMscope Frontend</name>
  <description>
    React UI. Vite writes its production build straight into
    target/classes/META-INF/resources, so packaging this module as a jar makes the
    whole UI available on the backend's classpath. Spring Boot serves static content
    from META-INF/resources automatically, which is what lets one jar contain both.

    Node and npm are expected to be installed on the machine and on the PATH. The
    minimum supported version is declared in package.json, so an unsupported Node
    fails with a clear message from npm rather than an obscure build error.
  </description>

  <profiles>
    <!-- npm ships as a shell script on Unix and a batch file on Windows, and a
         process launched without a shell has to name the right one. -->
    <profile>
      <id>npm-windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <properties>
        <npm.executable>npm.cmd</npm.executable>
      </properties>
    </profile>
    <profile>
      <id>npm-unix</id>
      <activation>
        <os><family>unix</family></os>
      </activation>
      <properties>
        <npm.executable>npm</npm.executable>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>

        <configuration>
          <executable>${npm.executable}</executable>
          <workingDirectory>${project.basedir}</workingDirectory>
        </configuration>

        <executions>
          <!-- "ci" rather than "install": installs exactly what package-lock.json
               pins and fails if the lock file and package.json disagree, so the
               build cannot silently drift onto different dependency versions. -->
          <execution>
            <id>npm-ci</id>
            <goals><goal>exec</goal></goals>
            <phase>initialize</phase>
            <configuration>
              <arguments>
                <argument>ci</argument>
              </arguments>
            </configuration>
          </execution>

          <!-- Vite transpiles without type checking, so types are verified explicitly.
               Runs before the build so a type error fails the Maven build rather than
               shipping into the jar. -->
          <execution>
            <id>npm-typecheck</id>
            <goals><goal>exec</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>
                <argument>run</argument>
                <argument>typecheck</argument>
              </arguments>
            </configuration>
          </execution>

          <execution>
            <id>npm-build</id>
            <goals><goal>exec</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
